@inproceedings{Tao2025,
   abstract = {The paper categorizes 5G system security into two types: 5G park system security and 5G wide area network system security. Among them, the security of 5G park systems is analyzed and researched in two modes: UPF sinking of 5G park systems and core network sinking of 5G park systems. The security of 5G wide area network system is analyzed and researched in two modes: core network logic specific slice security and core network physical specific slice security. Based on these, the cybersecurity classified protection model of 5G system are proposed, providing theoretical and technical support for the cybersecurity classified protection of 5G system. Protection technologies for 5G application systems should prioritize enhancing extended security requirements on the basis of traditional cybersecurity protection. Protection technologies of 5G application system can be derived from the cybersecurity classified protection model of 5G application and 5G application system type. Technology for cybersecurity classified protection of 5G application system are given from communication network security, area boundaries security, computing environment security, management center security and 5G terminal security.},
   author = {Yuan Tao and Moyan Li and Jing Xiao and Youjian Yao},
   doi = {10.1109/ICCSTE65902.2025.11138318},
   isbn = {9798331598273},
   booktitle = {2025 International Conference on Computer Science, Technology and Engineering, ICCSTE 2025},
   keywords = {5G application system security,5G park system security,5G wide area network system security,cybersecurity of classified protection model},
