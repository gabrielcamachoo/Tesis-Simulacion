@inproceedings{Ileana2025,
   abstract = {The proliferation of Internet of Things (IoT) devices has introduced significant security challenges due to their resource constraints and exposure to diverse cyber threats. Traditional intrusion detection systems (IDS) often rely on centralized architectures, which introduce latency, scalability limitations, and potential privacy risks. In this paper, we present a novel intelligent intrusion detection system specifically designed for IoT ecosystems, combining the benefits of explainable artificial intelligence (XAI) and distributed web system architectures. The proposed solution employs lightweight XAI models at the edge level for real-time detection and interpretability, while offloading complex threat analysis to a secure, cloud-backed infrastructure enabled by scalable distributed web technologies. This hybrid approach reduces detection latency, improves resource utilization, and enhances the explainability of alerts generated by the IDS. Experimental validation using the CIC-IDS2017 dataset demonstrates that the system achieves a high detection rate of up to 96%, with latency below 50 ms and reduced CPU and memory usage compared to traditional models. These results highlight the system’s potential to improve the security posture of modern IoT networks while maintaining transparency and operational efficiency.},
   author = {Marian Ileana and Pavel Petrov and Vassil Milev},
   doi = {10.1109/cyber-ai66431.2025.11233693},
   isbn = {9798331566319},
   month = {11},
   pages = {124-127},
   publisher = {Institute of Electrical and Electronics Engineers (IEEE)},
   title = {Intelligent Intrusion Detection in IoT with Explainable AI and Distributed Web Systems},
   year = {2025}
}
@inproceedings{Mishra2025,
   abstract = {With the increasing sophistication of cyber threats through Advanced Persistent Threats, ransomware, and insider attacks, innovative cybersecurity strategy is required, and AI represents a crucial instrument that uses deep learning and reinforcement learning to determine, analyze, and mitigate risks. This paper discusses AI-based cybersecurity, outlining a new model for AI, which improves on threat detection and response efficiency by increasing explainability. Analyzing large datasets and recognizing attack patterns and vulnerabilities to predict them has significantly improved the anomaly detection system and threat mitigation. The model also ensures that it follows ethical standards, including bias and transparency in AI-driven security. The results of this study show the significant advancements of cybersecurity resilience by integrating AI into modern threat defense. This AI-based approach offers scalable, adaptive, and proactive security. It allows organizations to effectively be prepared to deal with increasingly changing cyber threats.},
   author = {Mandakani Mishra and Rohit Raj Pradhan and Kesab Agrawalla and Raveendranadh Bokka},
   doi = {10.1109/ASSIC64892.2025.11158640},
   isbn = {9798331523022},
   booktitle = {3rd International Conference on Advancements in Smart, Secure and Intelligent Computing, ASSIC 2025},
   keywords = {AI,Anomaly Detection,Cybersecurity,Deep Learning,Reinforcement Learning,Threat Detection},
   publisher = {Institute of Electrical and Electronics Engineers Inc.},
   title = {AI for Cybersecurity Threat Detection: A Machine Enabled Computing Perspective},
   year = {2025}
}
@inproceedings{Pordelkhaki2021,
   abstract = {The continuous operation of an industrial process, such as water treatment or power generation, is governed by an Industrial Control System (ICS). Cyber-attacks on industrial networks are of growing concern because of the disruption they can cause, leading to loss of revenue, and the possibility of harm to workers, plant and surroundings. Operators therefore need a Network Intrusion Detection System (NIDS) to analyse industrial network traffic in real time for adversarial behaviour. Machine Learning (ML) is applicable to the problem of network intrusion detection. This paper investigates the possibility of training an ML-based NIDS for an ICS (specifically, the well-known Secure Water Treatment testbed) by combining network traffic data and physical process data. In the supplied dataset, data had already been labelled 'according to normal and abnormal behaviours'; the labelling of data collected around the start and end of each attack was scrutinized and, where found to be problematic, labelled data were excluded in order to improve the effectiveness of supervised learning. The ML technique of 'Learning using Privileged Information' was evaluated and found to be superior to six baseline ML algorithms trained on network traffic data alone.},
   author = {Moojan Pordelkhaki and Shereen Fouad and Mark Josephs},
   doi = {10.1109/ISI53945.2021.9624757},
   isbn = {9781665438384},
   booktitle = {Proceedings - 2021 IEEE International Conference on Intelligence and Security Informatics, ISI 2021},
   keywords = {Industrial Control System,Learning using Privileged Information,Machine Learning,Network Intrusion Detection System},
   publisher = {Institute of Electrical and Electronics Engineers Inc.},
   title = {Intrusion Detection for Industrial Control Systems by Machine Learning using Privileged Information},
   year = {2021}
}
