[Unit]
Description=Receptor MLLP de laboratorio - detector HL7/MLLP WATO (Tesis G18)
Documentation=file://__REPO_PATH__/README.md
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=__REPO_PATH__
Environment=LAB_AUTHORIZED=YES
ExecStartPre=__REPO_PATH__/.venv/bin/python __REPO_PATH__/deploy/receptor/make_deploy_settings.py __REPO_PATH__/evidence_output/settings_deploy.yaml
ExecStart=__REPO_PATH__/.venv/bin/python mllp_receiver.py --config __REPO_PATH__/evidence_output/settings_deploy.yaml --host 0.0.0.0 --port 1550 --verbose --outdir __REPO_PATH__/evidence_output
Restart=on-failure
RestartSec=5
User=__SERVICE_USER__
# Interlocks: sin privilegios de red salientes extra; el SafetyGuard valida
# LAB_AUTHORIZED + /LAB_ONLY.marker al arrancar el proceso.

[Install]
WantedBy=multi-user.target
